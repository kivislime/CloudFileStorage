# Spring app
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/FileStorageDb
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_PROFILES_ACTIVE=docker

# Ports
APP_PORT=8080
FRONTEND_PORT=80
POSTGRES_PORT=5432
MINIO_PORT=9000
